<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PEPacker.AotSmoke</AssemblyName>
    <RootNamespace>PEPacker.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>

    <!--
      Published with PublishAot to exercise PEPacker inside a Native AOT host, which the
      in-process xUnit suite can never do: it loads emitted assemblies in-process, so it has
      to stay managed. See tests/PEPacker.AotSmoke/Program.cs.
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The smoke host itself is not the thing under test; PEPacker's own warnings are
         ratcheted by the analyzer step in CI. -->
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PEPacker\PEPacker.csproj" />
  </ItemGroup>
</Project>
