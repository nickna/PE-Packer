<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>NickNa.PEPacker</PackageId>
    <Description>PE metadata rewriting and single-file executable bundling for .NET assemblies</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Consumers publish this inside Native AOT applications, so the trim, AOT and
      single-file analyzers run on every build rather than only when someone remembers
      to pass the flags. Verified: a published native binary round-trips an assembly
      through the full rewrite and produces a working single-file executable.
      TrimmerSingleWarn=false reports per-callsite rather than as one assembly rollup,
      which is what makes the CI ratchet meaningful.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!--
      Built-in bundling should not require an installed SDK. These build-only
      packages supply the small apphost templates embedded below; they do not
      become dependencies of NickNa.PEPacker. Source builders can opt out when
      producing a payload-minimal private build.
    -->
    <PEPackerEmbedAppHosts Condition="'$(PEPackerEmbedAppHosts)' == ''">true</PEPackerEmbedAppHosts>
    <PEPackerAppHostPackVersion>10.0.0</PEPackerAppHostPackVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The framework type map, precomputed so the rewriter works with no framework assemblies on
      disk. 31.6 KB compressed for the whole net10.0 surface, which is small enough to ship
      unconditionally rather than behind an opt-in. Regeneration command is in
      EmbeddedReferenceAssemblyIndex's remarks.
    -->
    <EmbeddedResource Include="Resources/refindex-net10.0.bin"
                      LogicalName="PEPacker.Resources.refindex-net10.0.bin" />
  </ItemGroup>

  <ItemGroup Condition="'$(PEPackerEmbedAppHosts)' == 'true'">
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-x64"
                     Version="[$(PEPackerAppHostPackVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-x86"
                     Version="[$(PEPackerAppHostPackVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-arm64"
                     Version="[$(PEPackerAppHostPackVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.linux-x64"
                     Version="[$(PEPackerAppHostPackVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.linux-arm"
                     Version="[$(PEPackerAppHostPackVersion)]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.linux-arm64"
                     Version="[$(PEPackerAppHostPackVersion)]" />

    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.win-x64/$(PEPackerAppHostPackVersion)/runtimes/win-x64/native/apphost.exe"
        LogicalName="PEPacker.Resources.apphost.win-x64" />
    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.win-x86/$(PEPackerAppHostPackVersion)/runtimes/win-x86/native/apphost.exe"
        LogicalName="PEPacker.Resources.apphost.win-x86" />
    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.win-arm64/$(PEPackerAppHostPackVersion)/runtimes/win-arm64/native/apphost.exe"
        LogicalName="PEPacker.Resources.apphost.win-arm64" />
    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.linux-x64/$(PEPackerAppHostPackVersion)/runtimes/linux-x64/native/apphost"
        LogicalName="PEPacker.Resources.apphost.linux-x64" />
    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.linux-arm/$(PEPackerAppHostPackVersion)/runtimes/linux-arm/native/apphost"
        LogicalName="PEPacker.Resources.apphost.linux-arm" />
    <EmbeddedResource
        Include="$(NuGetPackageRoot)microsoft.netcore.app.host.linux-arm64/$(PEPackerAppHostPackVersion)/runtimes/linux-arm64/native/apphost"
        LogicalName="PEPacker.Resources.apphost.linux-arm64" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PEPacker.Tests" />
    <!-- The AOT smoke host shares internal helpers (VersionUtil) rather than keeping a
         private copy of the version-directory parser that has been fixed repeatedly. -->
    <InternalsVisibleTo Include="PEPacker.AotSmoke" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
